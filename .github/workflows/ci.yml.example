# CI for the AOC repository itself (example: copy to .github/workflows/ci.yml).
#
# The required status check named in docs/compliance/self-modification-boundary.md (layer 3) is
# scripts/check.sh: typecheck, tests per package, then the packaging smoke test. Make the job below ("check") a
# required status check on the main-branch ruleset, with no bypass actors.
#
# .github/ is a Tier 1 path: a change to this file needs a code owner other than its author. Pin the actions to
# commit SHAs when you install it (a mutable tag is a supply-chain path into every build); the tags below are
# placeholders because this repository was built without network access to resolve them.
name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      # Reads the pnpm version from "packageManager" in package.json.
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22.13.0
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: bash scripts/check.sh
