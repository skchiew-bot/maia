{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/claude-session-start.mjs",
            "timeout": 300,
            "statusMessage": "Fetching history and dependencies, reading where the work stands"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/claude-stop-hook.mjs",
            "timeout": 60,
            "statusMessage": "Checking compliance docs against the code"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/claude-continuity-check.mjs",
            "timeout": 30,
            "statusMessage": "Checking for work that is not on GitHub yet"
          }
        ]
      }
    ]
  }
}
