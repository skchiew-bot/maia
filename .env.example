# aocd secrets — names only. Copy to .env (git-ignored), fill in, and start with:
#   node --env-file=.env dist/bin/aocd.mjs
# Non-secret settings belong in aoc.config.json (see aoc.config.example.json).

# 32-byte key-encryption key (64 hex chars or base64) wrapping the per-scope body keys. DEVELOPMENT ONLY:
# "mode": "production" refuses it and takes the KEK from keys.masterKeyFile. Unset: keys.masterKeyFile, else
# <dataDir>/master.key is generated (0600). See docs/runbooks/key-custody.md.
AOC_MASTER_KEY=

# One-time token the first Approver signs in with (printed once by `aoc init`).
AOC_BOOTSTRAP_TOKEN=

# Optional: only for fx.extractor = "anthropic-sdk" (and passed to sessions via supervisor.envAllowlist).
ANTHROPIC_API_KEY=

# Optional overrides of aoc.config.json:
# AOC_CONFIG=
# AOC_PORT=
# AOC_HOST=
# AOC_DATA_DIR=
# AOC_PUBLIC_URL=
# AOC_LOG_LEVEL=info
