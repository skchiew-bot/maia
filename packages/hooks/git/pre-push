#!/bin/sh
# AOC pre-push guard for managed workspaces.
#
# This is a SPEED BUMP, not a wall: `git push --no-verify`, another clone or `git -c core.hooksPath=... push` all skip
# it. The real wall is server-side branch protection plus credential isolation: protected-branch push rights and deploy
# keys exist only in supervisor-controlled session environments (AOC-SPEC-003 §2.4 and §3, risk R1). What this hook
# adds is a clear refusal at the moment of the attempt, before the remote has to say no.
#
# Refuses any push that updates or deletes a protected branch (main, master, production, release/*) unless
# AOC_SUPERVISOR_PUSH=1, which only the supervisor's promotion executor sets for an approved promotion (§8).
# Kept in lockstep with packages/hooks/src/prepush.ts (test/prepush.test.ts runs both against the same refs).
#
# Git passes "<remote name> <remote url>" as arguments and one line per ref on stdin:
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF

[ "${AOC_SUPERVISOR_PUSH:-}" = "1" ] && exit 0

refused=0
while read -r _local_ref _local_sha remote_ref _remote_sha || [ -n "${remote_ref:-}" ]; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master | refs/heads/production | refs/heads/release/* | main | master | production | release/*)
      echo "AOC: refusing to push to protected ref '$remote_ref'. Protected branches change only through an approved AOC promotion (AOC-SPEC-003 §8): push a feature branch and raise a change request." >&2
      refused=1
      ;;
  esac
  remote_ref=
done
exit "$refused"
